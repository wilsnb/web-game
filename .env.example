# Supabase — safe to expose to the browser (publishable / anon key).
# Copy this file to .env.local and fill in your project's values.
# Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the secret / service_role key here or in any NEXT_PUBLIC_ var.
# It belongs only in server-side, non-committed environments.
# Used by the Midtrans webhook to write subscriptions (bypasses RLS):
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans payment gateway.
# Dashboard: Settings → Access Keys
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY is safe for the browser (used by Snap.js).
# MIDTRANS_SERVER_KEY is SECRET — server-side only, never NEXT_PUBLIC_.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
# "true" for Production, "false" (or unset) for Sandbox.
MIDTRANS_IS_PRODUCTION=false
