# Supabase — safe to expose to the browser (publishable / anon key).
# Copy this file to .env.local and fill in your project's values.
# Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the secret / service_role key here or in any NEXT_PUBLIC_ var.
# It belongs only in server-side, non-committed environments.
